{
  "compilerOptions": {
    "target": "ES5",
    "module": "ESNext",
    "lib": ["ES5", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "noEmitOnError": true,
    "removeComments": false,
    "emitDeclarationOnly": true
  },
  "include": ["src/jquery.browser.d.ts"],
  "exclude": ["node_modules", "dist", "test", "src/**/*.js"]
}

